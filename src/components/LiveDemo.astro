---
const { code: propCode, id = Math.random().toString(36).slice(2, 7) } = Astro.props;
let code = propCode;

if (!code) {
  const html = await Astro.slots.render("default");
  if (html) {
    code = html
      .replace(/<span class="indent">[\s\S]*?<\/span>/g, (m) => m.replace(/<[^>]*>/g, ""))
      .replace(/<\/div><div[^>]*class="ec-line"[^>]*>/g, "\n")
      .replace(/<br\s*\/?>/gi, "\n")
      .replace(/<[^>]*>/g, "")
      .replace(/&amp;/g, "&")
      .replace(/&lt;/g, "<")
      .replace(/&gt;/g, ">")
      .replace(/&quot;/g, "\"")
      .replace(/&#39;/g, "'")
      .replace(/&#x27;/g, "'")
      .replace(/^\n+/, "")
      .replace(/\n+$/, "\n");
  }
}
---

<div id={`demo-${id}`} class="sinth-playground" data-instance-id={id}>
  <div class="sinth-playground-toolbar">
    <button type="button" class="sinth-btn sinth-reset">Reset</button>
    <button type="button" class="sinth-btn sinth-reload">Reload</button>
    <span class="sinth-status"></span>
  </div>
  <div class="sinth-playground-panes">
    <div class="sinth-playground-editor">
      <textarea class="sinth-editor-textarea" data-code={JSON.stringify(code || "")}></textarea>
    </div>
    <div class="sinth-playground-preview"></div>
  </div>
</div>

<script is:inline src="/sinth.js"></script>
<script is:inline>
  document.querySelectorAll(".sinth-playground").forEach(function(pg) {
    var id = pg.dataset.instanceId;
    var textarea = pg.querySelector(".sinth-editor-textarea");
    var preview = pg.querySelector(".sinth-playground-preview");
    var resetBtn = pg.querySelector(".sinth-reset");
    var reloadBtn = pg.querySelector(".sinth-reload");
    var statusEl = pg.querySelector(".sinth-status");
    if (!textarea || !preview || !resetBtn || !reloadBtn || !statusEl) return;

    var rawCode = JSON.parse(textarea.dataset.code);
    var lines = rawCode.split("\n");
    var minIndent = Infinity;
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i];
      if (line.trim() === "") continue;
      var leadingSpaces = line.match(/^ */)[0].length;
      if (leadingSpaces < minIndent) minIndent = leadingSpaces;
    }
    if (minIndent > 0 && minIndent < Infinity) {
      for (var i = 0; i < lines.length; i++) {
        lines[i] = lines[i].slice(minIndent);
      }
    }
    textarea.value = lines.join("\n").replace(/^\n+/, "").replace(/\n+$/, "\n");
    var originalCode = textarea.value;
    var timeout;

    function render() {
      try {
        var result = Sinth.compile(textarea.value);
        if (!result) return;
        var wrapper = document.createElement("div");
        wrapper.style.cssText = "width:100%;height:100%;overflow:auto;";
        wrapper.innerHTML = result.html;
        preview.innerHTML = "";
        preview.appendChild(wrapper);
        var oldScript = document.querySelector("script[data-sinth-instance='" + id + "']");
        if (oldScript) oldScript.remove();
        var s = document.createElement("script");
        s.setAttribute("data-sinth-instance", id);
        s.textContent = result.js;
        document.body.appendChild(s);
        statusEl.textContent = "Compiled";
        statusEl.style.color = "#4ade80";
      } catch (e) {
        statusEl.textContent = "Error: " + e.message;
        statusEl.style.color = "#f87171";
      }
    }

    textarea.addEventListener("input", function() {
      clearTimeout(timeout);
      timeout = setTimeout(render, 600);
    });

    resetBtn.addEventListener("click", function() {
      textarea.value = originalCode;
      render();
    });

    reloadBtn.addEventListener("click", render);
    render();
  });
</script>

<style>
  .sinth-playground {
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 8px;
    overflow: hidden;
    margin: 24px 0;
  }
  .sinth-playground-toolbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--sl-color-gray-6);
    border-bottom: 1px solid var(--sl-color-gray-4);
  }
  .sinth-btn {
    all: unset;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 4px;
    background: var(--sl-color-gray-5);
    color: var(--sl-color-gray-1);
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    white-space: nowrap;
    box-sizing: border-box;
  }
  .sinth-btn:hover { background: var(--sl-color-gray-4); }
  .sinth-status {
    margin-left: auto;
    font-size: 12px;
    font-family: monospace;
    color: var(--sl-color-gray-2);
    line-height: 1.4;
  }
  .sinth-playground-panes {
    display: flex;
    flex-direction: row;
    height: 400px;
    margin: 0;
  }
  .sinth-playground-editor {
    flex: 1;
    min-width: 0;
    border-right: 1px solid var(--sl-color-gray-4);
  }
  .sinth-editor-textarea {
    display: block;
    width: 100%;
    height: 100%;
    padding: 16px;
    border: none;
    outline: none;
    resize: none;
    margin: 0;
    font-family: var(--__sl-font-mono);
    font-size: 14px;
    line-height: 1.6;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    white-space: pre;
    overflow-wrap: normal;
    overflow-x: auto;
  }
  .sinth-playground-preview {
    flex: 1;
    min-width: 0;
    padding: 24px;
    background: var(--sl-color-bg);
    overflow: auto;
  }
</style>